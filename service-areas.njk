{% extends "layouts/base.njk" %}
{% block title %}Service Areas | Armadillo Tile and Home Repair{% endblock %}
{% block description %}Armadillo Tile is based in Baltimore City, with a focus on Baltimore City and County and surrounding communities including Carroll and Howard Counties.{% endblock %}
{% block content %}
<section class="page-intro">
  <p class="eyebrow">Where We Work</p>
  <h1>Local Tile And Home Repair</h1>
  <p>Based in Baltimore City, Armadillo Tile focuses on Baltimore City and County, while continuing to serve surrounding counties.</p>
</section>

<section class="card-grid" aria-label="Service area counties">
  <article class="service-area-card">
    <p class="card-label">Maryland</p>
    <h2>Baltimore City</h2>
    <p>Home base and primary service area.</p>
  </article>
  <article class="service-area-card">
    <p class="card-label">Maryland</p>
    <h2>Baltimore County</h2>
    <p>A primary focus for tile and home repair projects.</p>
  </article>
  <article class="service-area-card">
    <p class="card-label">Maryland</p>
    <h2>Carroll County</h2>
    <p>Still serving Carroll County and nearby communities.</p>
  </article>
  <article class="service-area-card">
    <p class="card-label">Maryland</p>
    <h2>Howard County</h2>
    <p>Ask about service in your area.</p>
  </article>
</section>

<section class="content-section">
  <div class="content-card">
    <h2>Not Sure If You're In Range?</h2>
    <p>Reach out with your location and project details to check availability in your area.</p>
  </div>
</section>
<div class="action-row">
  <a class="button-link" href="/contact/">Check Your Location</a>
  <a class="button-link button-link-secondary" href="/services/">Explore Services</a>
</div>
{% endblock %}
