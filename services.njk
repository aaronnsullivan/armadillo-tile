{% extends "layouts/base.njk" %}
{% block title %}Tile and Home Repair Services | Armadillo Tile{% endblock %}
{% block description %}Explore tile, bathroom, kitchen, grout repair, and small home repair services from Armadillo Tile and Home Repair.{% endblock %}
{% block content %}
<section class="page-intro">
  <p class="eyebrow">What We Do</p>
  <h1>The Right Work For Your Home</h1>
  <p>From a full shower redo to the little repair that has been on your list for months, we bring careful tile work and practical home repairs to Greater Baltimore.</p>
</section>

<section class="card-grid" aria-label="Services">
  <article class="content-card">
    <p class="card-label">Bathrooms</p>
    <h2>Showers And Tub Surrounds</h2>
    <p>Full tear-outs, new waterproofing, and clean tile layouts. Good tile is only as good as what is underneath it.</p>
    <a class="text-link" href="/bathroom-tile/">Bathroom tile details</a>
  </article>
  <article class="content-card">
    <p class="card-label">Kitchens</p>
    <h2>Backsplashes And Floors</h2>
    <p>Subway, stacked, herringbone, patterned tile, and kitchen floors set with care and clean lines.</p>
    <a class="text-link" href="/kitchen-tile/">Kitchen tile details</a>
  </article>
  <article class="content-card">
    <p class="card-label">Repairs</p>
    <h2>Regrout And Small Fixes</h2>
    <p>Cracked tiles, soft corners, tired grout, and the small repair work that still deserves a proper finish.</p>
    <a class="text-link" href="/tile-repair/">Tile repair details</a>
  </article>
  <article class="content-card">
    <p class="card-label">Home Repair</p>
    <h2>Handyman-Style Projects</h2>
    <p>Minor drywall patches, trim, caulking, and other small jobs that can pair well with tile work.</p>
    <a class="text-link" href="/home-repair/">Home repair details</a>
  </article>
</section>

<div class="action-row">
  <a class="button-link" href="/contact/">Get A Free Estimate</a>
  <a class="button-link button-link-secondary" href="/gallery/">See Examples Of Our Work</a>
</div>
{% endblock %}
