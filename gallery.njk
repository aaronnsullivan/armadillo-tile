{% extends "layouts/base.njk" %}
{% block title %}Project Gallery | Armadillo Tile and Home Repair{% endblock %}
{% block description %}Browse examples of tile and home repair work from Armadillo Tile and Home Repair.{% endblock %}
{% block content %}
<section class="page-intro">
  <p class="eyebrow">Our Work</p>
  <h1>Examples Of Our Work</h1>
  <p>A few examples of tile projects. Every home and project is different; get in touch to talk through yours.</p>
</section>

<section class="gallery-grid" aria-label="Project photos">
  <article class="gallery-card">
    <a href="/images/birdseyekitchen.png"><img src="/images/birdseyekitchen.png" alt="Bird's-eye view of a freshly tiled kitchen" loading="lazy"></a>
    <p class="gallery-caption">Kitchen Tile</p>
  </article>
  <article class="gallery-card">
    <a href="/images/blacktilebathroom.png"><img src="/images/blacktilebathroom.png" alt="Black tiled bathroom" loading="lazy"></a>
    <p class="gallery-caption">Black Tiled Bathroom</p>
  </article>
  <article class="gallery-card">
    <a href="/images/undermicrowave.png"><img src="/images/undermicrowave.png" alt="Framed tile under a microwave" loading="lazy"></a>
    <p class="gallery-caption">Framed Kitchen Tile</p>
  </article>
  <article class="gallery-card">
    <a href="/images/intricatetile.png"><img src="/images/intricatetile.png" alt="Intricately tiled bathroom floor" loading="lazy"></a>
    <p class="gallery-caption">Bathroom Floor Tile</p>
  </article>
</section>

<div class="action-row">
  <a class="button-link" href="/contact/">Talk About Your Project</a>
  <a class="button-link button-link-secondary" href="/reviews/">Read Google Reviews</a>
</div>
{% endblock %}
