    /* TRUST BAND (AUTO-SCROLL UP BACKGROUND ONLY) */
    .band { margin-bottom: 2.8rem; }

    .band-inner {
      background: transparent;
      border-radius: 1.4rem;
      padding: 2.2rem 2.2rem;
      color: #fdfdfd;
      box-shadow: 0 20px 40px rgba(0,0,0,0.35);
      position: relative;
      overflow: hidden;

      display: grid;
      grid-template-columns: 1.15fr 0.85fr;
      align-items: start;
      min-height: 560px;
    }

    .band-inner::after {
      content: "";
      position: absolute;
      inset: 0;
      background-image: url("images/armadillobackground.png");
      background-repeat: repeat;
      background-size: auto;
      background-position: center 0px;
      z-index: 0;
      pointer-events: none;
      animation: bandPatternUp 380s linear infinite;
    }

    @keyframes bandPatternUp {
      from { background-position: center 0px; }
      to { background-position: center -2600px; }
    }

    .band-inner::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(
        90deg,
        rgba(0,0,0,0.00) 0%,
        rgba(0,0,0,0.00) 52%,
        rgba(0,0,0,0.30) 75%,
        rgba(0,0,0,0.55) 100%
      );
      pointer-events: none;
      z-index: 1;
    }

    .band-text {
      position: relative;
      z-index: 2;
