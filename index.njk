      function openNav() {
        document.body.classList.add("nav-open");
        burger.setAttribute("aria-expanded", "true");
        mobileNav.setAttribute("aria-hidden", "false");
      }

      function closeNav() {
        document.body.classList.remove("nav-open");
        burger.setAttribute("aria-expanded", "false");
        mobileNav.setAttribute("aria-hidden", "true");
      }

      burger?.addEventListener("click", () => {
        document.body.classList.contains("nav-open") ? closeNav() : openNav();
      });

      backdrop?.addEventListener("click", closeNav);

     mobileNav?.addEventListener("click", (e) => {
  if (e.target.dataset?.close === "true" || e.target.tagName === "A") {
    closeNav();
  }
});

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeNav();
      });
    })();
  </script>

  <!-- Hidden Easter egg audio -->
  <audio id="easterEggAudio" preload="none">
    <source src="images/armadillotileandhomerepair.mp3" type="audio/mpeg" />
  </audio>

 <script>
  const CODES = [
    "playmyfuckingsong",
    "play my fucking song"
  ];

  const STOP_CODES = [
    "stopsong",
    "stop song"
  ];

  let buffer = "";
  let triggered = false;

  function playEasterEgg() {
    const audio = document.getElementById("easterEggAudio");
    if (!audio) return;

    audio.volume = 0.8;
    audio.currentTime = 0;

    const p = audio.play();
    if (p && typeof p.catch === "function") {
      p.catch(() => {
        alert("Easter egg unlocked. Tap OK to play.");
        audio.play().catch(() => {});
      });
    }
  }

  function stopEasterEgg() {
    const audio = document.getElementById("easterEggAudio");
    if (!audio) return;

    audio.pause();
    audio.currentTime = 0;
  }

  window.addEventListener("keydown", (e) => {
    if (e.key.length !== 1) return;

    buffer += e.key.toLowerCase();

    const maxLength = Math.max(
      ...CODES.map(c => c.length),
      ...STOP_CODES.map(c => c.length)
    );

    if (buffer.length > maxLength) {
      buffer = buffer.slice(buffer.length - maxLength);
    }

    if (STOP_CODES.some(code => buffer.endsWith(code))) {
      stopEasterEgg();
      buffer = "";
      triggered = false;
      return;
    }

    if (!triggered && CODES.some(code => buffer.endsWith(code))) {
      triggered = true;
      playEasterEgg();
      setTimeout(() => {
        triggered = false;
        buffer = "";
      }, 2000);
    }
  });
</script>

